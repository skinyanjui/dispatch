# Fictional local development only. Use managed PostgreSQL + unique credentials in deployment.
DATABASE_URL=postgresql://relay:relay_local@127.0.0.1:5432/relay
# HTTPS deployments must set true.
COOKIE_SECURE=false
# Set locally before npm run db:seed. Do not commit an actual password.
SEED_PASSWORD=
# Set the canonical HTTPS origin in deployment, without a trailing slash.
# Emailed links (reset, invitation, verification) use it; in production they
# never use the request's Origin, falling back to the Vercel host if unset.
# APP_ORIGIN=https://your-domain.example
# Number of proxies in front of the app (the client address is taken that many
# entries from the right of X-Forwarded-For). Default 1; Vercel needs no change.
# RELAY_PROXY_HOPS=1
# Require two-step verification for staff roles (organization members, dispatchers,
# carrier managers). Needs RELAY_DATA_KEY.
# RELAY_REQUIRE_MFA=true
# Hours that approved payout details wait before they count (0 to 168, default 24; ADR 0064).
# RELAY_PAYOUT_COOLING_HOURS=24
# Carrier registration lookups (ADR 0065): fixture (fictional) or fmcsa (public
# QCMobile service; needs FMCSA_WEBKEY). In production one must be chosen.
# RELAY_AUTHORITY_PROVIDER=fmcsa
# FMCSA_WEBKEY=
# During key rotation only: the old RELAY_DATA_KEY (docs/runbooks/key-rotation.md).
# RELAY_DATA_KEY_PREVIOUS=
# HTTPS webhook for operational alerts (docs/runbooks/alerting.md).
# RELAY_ALERT_WEBHOOK_URL=
# Owner-role connection used only for migrations (docs/runbooks/database-roles.md).
# MIGRATION_DATABASE_URL=
# Fail production builds on insecure configuration instead of warning.
# RELAY_STRICT_CONFIG=true
# Optional hosted fictional QA setup, not for real operational data.
# Vercel Production builds always migrate; QA seeding requires this explicit flag
# plus SEED_PASSWORD. Existing account passwords are never reset by reseeding.
# RELAY_QA_SEED=true
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts queued email
# bodies and MFA secrets. Without it emails are recorded as not sent and MFA
# enrollment is unavailable. Rotate by re-enrolling MFA; keep it secret.
RELAY_DATA_KEY=
# Email delivery: unset/none (record only), log (development: server log, no
# email), or resend (requires RESEND_API_KEY and a verified RELAY_EMAIL_FROM).
# RELAY_EMAIL_TRANSPORT=log
# RESEND_API_KEY=
# RELAY_EMAIL_FROM=Relay <dispatch@your-domain.example>
# Text messages from the Inbox: off unless set. Each text is attempted once
# (a timeout is recorded as "unknown", never retried). Only people who agreed
# to texts can be messaged.
# RELAY_SMS_TRANSPORT=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100
# Hours ahead that drivers are reminded of pickups and deliveries (3-72).
# RELAY_APPOINTMENT_REMINDER_HOURS=24
# Inbound replies (optional, ADR 0023). RELAY_INBOUND_SECRET signs the email
# webhook (POST /api/webhooks/email, header x-relay-signature: sha256=<hmac of
# the raw body>); RELAY_INBOUND_EMAIL_DOMAIN is a domain whose mail your
# provider forwards to that webhook. Point Twilio's inbound SMS webhook at
# POST /api/webhooks/sms (verified with TWILIO_AUTH_TOKEN; set APP_ORIGIN to the
# public URL so the signature can be checked).
# MMS pictures also need TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN (ADR 0025).
# Object storage credentials need s3:DeleteObject for abandoned-upload cleanup.
# RELAY_INBOUND_SECRET=
# RELAY_INBOUND_EMAIL_DOMAIN=mail.your-domain.example
# Required by the scheduled reminder/delivery job (/api/jobs/notifications).
# vercel.json runs the daily sweep. For the two-hour appointment reminders and
# faster delivery retries something must also call
#   GET /api/jobs/notifications?scope=tick   (Authorization: Bearer $CRON_SECRET)
# every ~15 minutes: a Vercel Pro cron, an external pinger, or the repository's
# .github/workflows/scheduler.yml (set the variable RELAY_JOBS_URL and the secret
# CRON_SECRET). See ADR 0046.
# CRON_SECRET=
# Document storage: unset/postgres keeps files in PostgreSQL (development).
# s3 stores them in any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# Use a private bucket with versioning or object lock; Relay never deletes.
# RELAY_DOCUMENT_STORE=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1          (R2: auto)
# S3_BUCKET=relay-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_VIRTUAL_HOSTED=false       (true for bucket.host style URLs)
# Malware scanning through a clamd (ClamAV) daemon you operate.
# RELAY_MALWARE_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# With a bucket, files over 4 MB (up to 25 MB) upload straight to it. The
# bucket needs CORS allowing PUT from the app origin and a lifecycle rule
# expiring the quarantine/ prefix after 1 day (docs/decisions/0015).
# Refuse uploads unless a scanner returns a verdict. Set true in production.
# RELAY_REQUIRE_MALWARE_SCAN=true
# AI document reading (ADR 0028). Off unless a key is set AND an organization
# owner or admin turns it on in Organization settings. Cost follows the model.
# ANTHROPIC_API_KEY=
# RELAY_AI_MODEL=claude-opus-5-5
# QA, demos and CI: labelled sample values, no network. Ignored on Vercel production.
# RELAY_AI_PROVIDER=fixture

# Google and Apple sign-in (ADR 0034). Off until set. Register the redirect
# URLs <APP_ORIGIN>/api/auth/oidc/google/callback and .../apple/callback.
# People without a Relay account only create an access request.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=         # the Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=       # PEM contents; \n is accepted for line breaks
# Page Content-Security-Policy allows connecting to the object-storage host from
# S3_* automatically (read at build time). Extra origins, space separated:
# RELAY_CSP_CONNECT_EXTRA=

# Resend's native outbound delivery events (separate from inbound email).
# Configure https://your-domain.example/api/webhooks/email-status in Resend.
# Use the endpoint's whsec_ signing secret; never share its value in chat.
# RESEND_WEBHOOK_SECRET=
# Twilio sends signed status callbacks automatically when APP_ORIGIN is HTTPS.
# The same TWILIO_AUTH_TOKEN verifies them at /api/webhooks/sms-status.
