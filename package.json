{
  "name": "relay-dispatch-tms",
  "version": "0.1.0",
  "private": true,
  "description": "Carrier-agent freight dispatch TMS browser prototype and Codex handoff",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "start": "next start --hostname 0.0.0.0",
    "build": "next build",
    "build:vercel": "tsx scripts/prepare-deployment.ts && next build",
    "lint": "eslint src scripts/*.ts tests/**/*.ts && node scripts/check-design-system.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/check.mjs",
    "test": "node --test tests/smoke.test.mjs && tsx --test tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "org:create": "tsx scripts/create-organization.ts",
    "access:list": "tsx scripts/access-requests.ts list",
    "access:approve": "tsx scripts/access-requests.ts approve",
    "access:decline": "tsx scripts/access-requests.ts decline",
    "documents:migrate-storage": "tsx scripts/migrate-document-storage.ts",
    "demo": "node scripts/dev.mjs",
    "build:demo": "node scripts/build.mjs",
    "audit:actions": "node scripts/action-register.mjs",
    "verify:restore": "node scripts/verify-local-restore.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skinyanjui/dispatch.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
