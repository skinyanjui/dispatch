{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/jobs/notifications",
      "schedule": "7 13 * * *"
    }
  ]
}
